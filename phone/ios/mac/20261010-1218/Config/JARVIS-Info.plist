<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the generated Info.plist (INFOPLIST_FILE with GENERATE_INFOPLIST_FILE). The jarvis:// scheme
	     is how the lock-screen and Control Center button (the JARVISControls extension), Back Tap or a Shortcut
	     opens the app: jarvis://listen starts hands-free listening, jarvis://stop raises the emergency stop. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.teagueindustries.jarvis</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>jarvis</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
