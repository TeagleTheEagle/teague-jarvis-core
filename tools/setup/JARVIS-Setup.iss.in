; JARVIS-Setup (docs/OWN-APP-PLAN.md 3.4). This is the template; tools/setup/build_setup.py fills the @NAME@ fields and
; writes JARVIS-Setup-<release id>.iss beside the package, which Inno Setup 6 compiles. Do not edit a generated copy.
;
; What the Setup does: unpacks the package (release\, installer.py) into %LOCALAPPDATA%\JARVIS-package, per user and
; without administrator rights, then runs the package's own installer.py, which installs or updates JARVIS exactly as
; the Stage 7 check has proven (the previous release kept as the rollback copy; data, keys and preferences untouched),
; and registers "JARVIS" in Settings > Apps > Installed apps. Uninstall there asks first, then runs the package's
; installer with `uninstall` (program removed, data kept) and then removes the package folder and the entry.
; Switches: /VERYSILENT /SUPPRESSMSGBOXES /NORESTART (silent); /HOME=<folder> (a sandbox install home, as installer.py
; --home; needs /DIR as well, and registers as "JARVIS (sandbox)" under its own application id, so a rehearsal on the
; build PC never touches the entry of the real JARVIS there); /DIR=<folder> (a sandbox package folder, Inno's own
; switch); /NOSHORTCUTS (rehearsals on the build PC; the installer itself also withholds the real shortcuts from any
; home that is not the PC's own install home); /LOG=<file>. The installer's JSON answer is kept in
; {app}\setup-result.json; the uninstall's in <package folder>-uninstall-result.json beside the folder (the folder
; itself is removed by the uninstall). A silent Setup exits 0 even when the package's installer refused (Inno Setup
; has finished its own work by then): setup-result.json is the verdict; on a refusal the Setup removes the
; Installed-apps entry it wrote and the finished page says that nothing was installed.

#define MyAppGuid "DC2C8033-1BBF-5E1C-99A0-BE0E70DC9937"
#define SandboxAppGuid "7A3F1C52-9E4B-4D16-8C0D-2B5E6F7A9D31"

[Setup]
AppId={code:AppIdForThisRun}
AppName=JARVIS
AppVersion=@VERSION@
AppVerName=JARVIS @VERSION@
AppPublisher=Teague Industries
AppComments=JARVIS release @RELEASE_ID@
DefaultDirName={localappdata}\JARVIS-package
UsePreviousAppDir=no
UsePreviousLanguage=no
DisableDirPage=yes
DisableProgramGroupPage=yes
DisableReadyPage=no
PrivilegesRequired=lowest
OutputDir=@OUTPUT_DIR@
OutputBaseFilename=@OUTPUT_NAME@
SetupIconFile=@ICON@
UninstallDisplayName={code:UninstallNameForThisRun}
UninstallDisplayIcon={code:JarvisProgram}
Compression=lzma2/normal
SolidCompression=yes
LZMAUseSeparateProcess=yes
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
WizardStyle=modern
ShowLanguageDialog=no
CloseApplications=no
RestartApplications=no
SetupLogging=yes
MinVersion=10.0
VersionInfoVersion=@VERSION_QUAD@
VersionInfoCompany=Teague Industries
VersionInfoDescription=JARVIS Setup
VersionInfoProductName=JARVIS
VersionInfoProductVersion=@VERSION_QUAD@

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Messages]
WelcomeLabel2=This will install JARVIS @VERSION@ on this PC, for your user account only (no administrator rights).%n%nIf JARVIS is already installed it is updated: the previous release is kept as a rollback copy, and your data, keys and preferences are untouched.
FinishedLabelNoIcons=JARVIS @VERSION@ is installed.
FinishedLabel=JARVIS @VERSION@ is installed.

; A newer Setup over an older package: the old release files go first, so the package holds exactly this release
; (the installer verifies the package file by file and refuses anything extra). The no-shortcuts marker goes too:
; each install decides from its own command line and writes the marker again when the switch is given.
[InstallDelete]
Type: filesandordirs; Name: "{app}\release"
Type: files; Name: "{app}\installer.py"
Type: files; Name: "{app}\install.cmd"
Type: files; Name: "{app}\setup-result.json"
Type: files; Name: "{app}\setup-noshortcuts.txt"

[Files]
Source: "@PACKAGE@\*"; DestDir: "{app}"; Flags: recursesubdirs createallsubdirs ignoreversion

; What the Setup itself wrote beside the package goes with it; the uninstall's own answer is kept beside the folder
; (<package folder>-uninstall-result.json), where the Stage 7 check reads it.
[UninstallDelete]
Type: files; Name: "{app}\setup-result.json"
Type: files; Name: "{app}\setup-home.txt"
Type: files; Name: "{app}\setup-noshortcuts.txt"
Type: dirifempty; Name: "{app}"

[Run]
Filename: "{code:JarvisProgram}"; WorkingDir: "{code:JarvisProgramFolder}"; Description: "Start JARVIS"; Flags: postinstall nowait skipifsilent; Check: InstallSucceeded

[Code]
var
  Installed: Boolean;

function HomeOverride(): String;
begin
  { A trailing backslash would swallow the closing quote of --home "..." on the installer's command line. }
  Result := RemoveBackslashUnlessRoot(Trim(ExpandConstant('{param:HOME|}')));
end;

{ A sandbox run (/HOME given) registers under its own application id and name, so a rehearsal on the build PC never
  touches the entry of the real JARVIS there, and the real Setup never touches a sandbox's. The ids are read from
  this template by the build tool into the Setup's record (app_id, sandbox_app_id). }
function IsSandbox(): Boolean;
begin
  Result := HomeOverride() <> '';
end;

function AppIdForThisRun(Param: String): String;
begin
  if IsSandbox() then Result := '{' + '{#SandboxAppGuid}' + '}' else Result := '{' + '{#MyAppGuid}' + '}';
end;

function UninstallNameForThisRun(Param: String): String;
begin
  if IsSandbox() then Result := 'JARVIS (sandbox)' else Result := 'JARVIS';
end;

function HomeOrDefault(const Home: String): String;
begin
  Result := Home;
  if Result = '' then Result := ExpandConstant('{localappdata}\JARVIS');
end;

function JarvisHome(): String;
begin
  Result := HomeOrDefault(HomeOverride());
end;

function JarvisProgramFolder(Param: String): String;
begin
  Result := JarvisHome() + '\releases\@RELEASE_ID@\electron';
end;

function JarvisProgram(Param: String): String;
begin
  Result := JarvisProgramFolder('') + '\JARVIS.exe';
end;

function InstallSucceeded(): Boolean;
begin
  Result := Installed;
end;

function HomeArgument(const Home: String): String;
begin
  if Home <> '' then Result := ' --home "' + Home + '"' else Result := '';
end;

{ A switch given on the command line, bare (/NOSHORTCUTS) or with a value (/NOSHORTCUTS=1). Inno's own param:
  constant reads only the /NAME=value form: a bare switch read as empty, so the 2026-10-07 rehearsal's install
  and uninstall ran the package's installer without --no-shortcuts (docs/OWN-APP-1.0.17.md section 6). The
  installer itself now also refuses to touch the real shortcuts for a home that is not the PC's own install
  home. No brace inside this comment: a Pascal comment ends at the first closing brace. }
function HasSwitch(const Name: String): Boolean;
var
  I: Integer;
begin
  Result := False;
  for I := 1 to ParamCount do
    if (CompareText(ParamStr(I), '/' + Name) = 0) or (Pos(UpperCase('/' + Name + '='), UpperCase(ParamStr(I))) = 1) then Result := True;
end;

{ A sandbox home needs a sandbox package folder too: /HOME without /DIR would unpack into the real package folder
  and point a sandbox entry at it. Refused before anything is done (a silent Setup then exits 1). }
function InitializeSetup(): Boolean;
begin
  Result := True;
  if IsSandbox() and not HasSwitch('DIR') then
  begin
    Log('/HOME was given without /DIR: refused (a sandbox install home needs a sandbox package folder). Nothing was done.');
    if not WizardSilent() then MsgBox('/HOME needs /DIR as well (a sandbox install home needs a sandbox package folder). Nothing was done.', mbError, MB_OK);
    Result := False;
  end;
end;

{ /NOSHORTCUTS: rehearsals on the build PC never touch its real Desktop and Startup folders (remembered for the uninstall). }
function NoShortcutsArgument(): String;
begin
  if HasSwitch('NOSHORTCUTS') or FileExists(ExpandConstant('{app}\setup-noshortcuts.txt')) then Result := ' --no-shortcuts' else Result := '';
end;

{ The package's installer, with the package's own Python; its JSON answer goes to a file beside the package. }
function RunInstaller(const Action, Home, ResultFile: String; var Code: Integer): Boolean;
var
  Command: String;
begin
  Command := '/c ""' + ExpandConstant('{app}\release\python\python.exe') + '" "' + ExpandConstant('{app}\installer.py') + '" '
             + Action + HomeArgument(Home) + NoShortcutsArgument() + ' > "' + ResultFile + '" 2>&1"';
  Log('JARVIS installer: cmd ' + Command);
  Result := Exec(ExpandConstant('{cmd}'), Command, ExpandConstant('{app}'), SW_HIDE, ewWaitUntilTerminated, Code);
  if not Result then Code := -1;
end;

procedure CurStepChanged(CurStep: TSetupStep);
var
  Code: Integer;
  Lines: TArrayOfString;
  Note: String;
begin
  if CurStep = ssPostInstall then
  begin
    { The install home is remembered for the uninstall (a sandbox home never touches the real JARVIS); UTF-8, so a
      home path with letters outside the ANSI code page is read back as written. }
    SetArrayLength(Lines, 1);
    Lines[0] := HomeOverride();
    SaveStringsToUTF8File(ExpandConstant('{app}\setup-home.txt'), Lines, False);
    if HasSwitch('NOSHORTCUTS') then SaveStringToFile(ExpandConstant('{app}\setup-noshortcuts.txt'), '1', False);
    RunInstaller('install --package "' + ExpandConstant('{app}') + '"', HomeOverride(), ExpandConstant('{app}\setup-result.json'), Code);
    Installed := Code = 0;
    if not Installed then
    begin
      { Nothing was installed, so the entry this Setup wrote a moment ago must not say that JARVIS is installed:
        it is removed again. The package folder stays (the next run of the Setup replaces it). }
      if RegDeleteKeyIncludingSubkeys(HKCU, 'Software\Microsoft\Windows\CurrentVersion\Uninstall\' + AppIdForThisRun('') + '_is1') then
        Log('The installer refused: the Installed-apps entry was removed again.')
      else
        Log('The installer refused, and the Installed-apps entry could not be removed.');
      Note := 'JARVIS could not be installed (the installer answered ' + IntToStr(Code) + '). Nothing in JARVIS was changed.'
              + #13#10 + 'Details: ' + ExpandConstant('{app}\setup-result.json')
              + #13#10 + 'Quit JARVIS completely (its icon near the clock) and run this Setup again.';
      Log(Note);
      if not WizardSilent() then MsgBox(Note, mbError, MB_OK);
    end;
  end;
end;

{ The finished page must not say "installed" after a refusal. }
procedure CurPageChanged(CurPageID: Integer);
begin
  if (CurPageID = wpFinished) and not Installed then
    WizardForm.FinishedLabel.Caption := 'JARVIS @VERSION@ was NOT installed: the installer refused (details in '
      + ExpandConstant('{app}\setup-result.json') + '). Nothing in JARVIS was changed.'
      + #13#10#13#10 + 'Quit JARVIS completely (its icon near the clock) and run this Setup again.';
end;

{ Uninstall: first JARVIS itself through the package's installer (program removed, data kept); only when that
  succeeded does Setup remove the package folder and the Installed-apps entry. A refusal (JARVIS still running)
  keeps everything so the uninstall can be run again. Inno asks its own "are you sure" only after this function,
  so the real question is asked here first: a "No" does nothing at all. }
function InitializeUninstall(): Boolean;
var
  Code: Integer;
  Lines: TArrayOfString;
  Home, Note: String;
begin
  Result := True;
  if not FileExists(ExpandConstant('{app}\installer.py')) then exit;
  Home := '';
  if LoadStringsFromFile(ExpandConstant('{app}\setup-home.txt'), Lines) and (GetArrayLength(Lines) > 0) then Home := Trim(Lines[0]);
  if not UninstallSilent() then
    if MsgBox('Remove JARVIS from this PC?' + #13#10#13#10 + 'The program is removed (JARVIS is closed first if it is running). Your data, keys and preferences stay in '
              + HomeOrDefault(Home) + '.', mbConfirmation, MB_YESNO) <> IDYES then
    begin
      Result := False;
      exit;
    end;
  RunInstaller('uninstall', Home, ExpandConstant('{app}') + '-uninstall-result.json', Code);
  if Code <> 0 then
  begin
    Note := 'JARVIS could not be removed (the installer answered ' + IntToStr(Code) + '). JARVIS is still installed.'
            + #13#10 + 'Details: ' + ExpandConstant('{app}') + '-uninstall-result.json'
            + #13#10 + 'Quit JARVIS completely (its icon near the clock) and run the uninstall again.';
    Log(Note);
    if not UninstallSilent() then MsgBox(Note, mbError, MB_OK);
    Result := False;
  end;
end;
