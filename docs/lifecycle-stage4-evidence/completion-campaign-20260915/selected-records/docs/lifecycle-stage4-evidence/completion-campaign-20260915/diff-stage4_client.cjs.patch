+// TEST client-local mechanics only. Core grants authority; this class can only
+// shorten it. No hardware, provider, automatic reacquisition or replay.
+class MediaWatchdog {
+ constructor(call,{epoch,clock=()=>performance.now(),onStop=()=>{},onStart=()=>{}}){
+  this.call=call;this.epoch=epoch;this.clock=clock;this.onStop=onStop;this.onStart=onStart;
+  this.active=new Map();this.serial={capture:0,playback:0};this.pending=new Set();
+ }
+ async start(purpose,requestId=null){
+  requireThat(['capture','playback'].includes(purpose),'MEDIA_PURPOSE');
+  requireThat(!this.active.has(purpose)&&!this.pending.has(purpose),'MEDIA_BUSY');
+  const generation=++this.serial[purpose],sent=this.clock();this.pending.add(purpose);
+  try{
+   const grant=await this.call('media',{purpose,request_id:requestId,lease_id:null});
+   const deadline=this.deadline(grant,sent);
+   requireThat(generation===this.serial[purpose]&&this.clock()<deadline,'MEDIA_STALE');
+   this.active.set(purpose,{id:grant.id,requestId,generation,deadline,renewAt:sent+3000,renewing:false});
+   this.onStart(purpose);return this.snapshot();
+  }finally{if(generation===this.serial[purpose])this.pending.delete(purpose);}
+ }
+ deadline(grant,sent){
+  requireThat(grant?.epoch===this.epoch&&typeof grant.id==='string'&&/^[a-f0-9]{32}$/.test(grant.id)&&
+   Number.isInteger(grant.valid_for_ms)&&grant.valid_for_ms>0&&grant.valid_for_ms<=10000,'MEDIA_GRANT');
+  return sent+grant.valid_for_ms;
+ }
+ stop(purpose,reason='LOCAL_STOP'){
+  requireThat(['capture','playback'].includes(purpose),'MEDIA_PURPOSE');
+  const lease=this.active.get(purpose);++this.serial[purpose];this.pending.delete(purpose);this.active.delete(purpose);
+  this.onStop(purpose,reason);
+  // Stop local output first; Core release is best effort and never grants work.
+  if(lease)return this.call('stop-'+purpose,{lease_id:lease.id}).catch(()=>({result:'LOCAL_STOPPED_RELEASE_UNCONFIRMED'}));
+  return Promise.resolve({result:'LOCAL_STOPPED'});
+ }
+ stopAll(reason){for(const purpose of ['capture','playback'])this.stop(purpose,reason);}
+ guard(purpose,generation,callback){
+  const lease=this.active.get(purpose);
+  if(!lease||lease.generation!==generation||this.clock()>=lease.deadline)return false;
+  callback();return true;
+ }
+ tick(){
+  for(const [purpose,lease] of this.active){
+   const now=this.clock();
+   if(now>=lease.deadline){this.stop(purpose,'LEASE_EXPIRED');continue;}
+   if(now<lease.renewAt||lease.renewing)continue;
+   lease.renewing=true;
+   this.call('media',{purpose,request_id:lease.requestId,lease_id:lease.id}).then(grant=>{
+    if(this.active.get(purpose)!==lease||this.serial[purpose]!==lease.generation)return;
+    if(this.clock()>=lease.deadline){this.stop(purpose,'LEASE_EXPIRED');return;}
+    requireThat(grant.id===lease.id,'MEDIA_CHANGED');
+    const deadline=this.deadline(grant,now);requireThat(this.clock()<deadline,'MEDIA_STALE');
+    lease.deadline=deadline;lease.renewAt=now+3000;lease.renewing=false;
+   }).catch(()=>{if(this.active.get(purpose)===lease)this.stop(purpose,'RENEWAL_DENIED');});
+  }
+ }
+ snapshot(){return {mode:'MODELED_NO_HARDWARE',active:[...this.active].map(([purpose,x])=>({purpose,generation:x.generation,deadline:x.deadline})),pending:[...this.pending]};}
+}
