+def publish_coordinator_readiness(path, payload, name):
+    """Completion is an inherited-pipe signal, not destination-file visibility."""
+    def signal(state, **fields):
+        print('STAGE4_READINESS '+json.dumps(dict(name=name,state=state,**fields)),flush=True)
+    temporary=path.with_name(path.name+'.'+uuid.uuid4().hex+'.tmp')
+    signal('PUBLISHING')
+    try:
+        temporary.write_text(json.dumps(payload),encoding='utf8')
+        os.replace(temporary,path)
+    except BaseException as exc:
+        import traceback
+        signal('FAILED',error={'type':type(exc).__name__,'message':str(exc),
+               'errno':getattr(exc,'errno',None),'winerror':getattr(exc,'winerror',None),
+               'traceback':traceback.format_exc()})
+        raise
+    finally:
+        if temporary.exists():temporary.unlink()
+    signal('COMPLETE')
+
