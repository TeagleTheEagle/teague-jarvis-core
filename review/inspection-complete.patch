+            if errors:
+                raise RuntimeError('Frontend rendering failed; no visual evidence submitted.')
+            report['verified_panel']=request['panel']
+            if request['panel']=='changes':report['limitations'].append('Change records and diffs are omitted; only the panel shell was inspected.')
+            report['stages']['panel_rendered']='completed'
+            report['captured_at']=stamp()
+            # Bounded real section captures, including nested scroll containers.
+            sections = page.evaluate("panel=>{const root=document.getElementById(panel+'View');return [document.scrollingElement,...root.querySelectorAll('*')].filter(e=>e.scrollHeight>e.clientHeight+4&&e.clientHeight>40).slice(0,5).map((e,i)=>{e.dataset.inspectionScroll=String(i);return {id:i,height:e.scrollHeight,view:e.clientHeight};});}",request['panel'])
+            positions=[None]
+            if request['scope']=='full_panel':
+                for s in sections:
+                    for offset in range(0, min(s['height'], s['view']*6), max(1,s['view']-80)):
+                        if len(positions)>=MAX_CAPTURES:break
